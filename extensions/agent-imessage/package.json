{
  "name": "agent-imessage",
  "displayName": "Agent iMessage",
  "description": "Open the standalone Agent iMessage Gateway. The editor does not manage the Gateway lifecycle.",
  "version": "1.0.0",
  "publisher": "showin2333",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:agentImessage.openSettings"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentImessage.openSettings",
        "title": "Agent iMessage: Open Gateway"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "package": "npm run compile && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.2"
  }
}
