{
  "name": "@showin2333/agent-imessage",
  "version": "1.0.0",
  "description": "Standalone iMessage Agent Gateway with Cursor SDK, Codex App Server and DSH backends",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShoWin2333/agent-imessage.git"
  },
  "bugs": {
    "url": "https://github.com/ShoWin2333/agent-imessage/issues"
  },
  "homepage": "https://github.com/ShoWin2333/agent-imessage#readme",
  "keywords": [
    "agent",
    "gateway",
    "imessage",
    "photon",
    "cursor",
    "codex",
    "dsh"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/types/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types",
    "public",
    "README.md",
    "README.en.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.app.json",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "start": "node lib/types/app/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm test && npm run build && npm pack --dry-run --ignore-scripts",
    "prepare": "npm run build",
    "test:codex:live": "node scripts/codex-smoke.mjs",
    "test:cursor:live": "node scripts/cursor-smoke.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "package:macos": "node scripts/macos/package.mjs",
    "test:macos:package": "node scripts/macos/package-smoke.mjs",
    "test:macos:native": "node scripts/macos/native-smoke.mjs",
    "test:macos:service": "node scripts/macos/service-tests.mjs",
    "test:macos:store": "node scripts/macos/native-store-tests.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "1.10.0",
    "@cursor/sdk": "1.0.31",
    "@elysiajs/eden": "1.4.9",
    "@spectrum-ts/core": "12.7.0",
    "@spectrum-ts/imessage": "12.7.0",
    "better-auth": "1.6.30",
    "elysia": "1.4.28",
    "qrcode": "^1.5.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@photon-ai/dashboard-api": "1.6.12",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "6.0.3",
    "vitest": "^3.2.4"
  },
  "bin": {
    "agent-imessage": "./lib/types/app/cli.js"
  },
  "overrides": {
    "@connectrpc/connect-node": {
      "undici": "^6.28.0"
    }
  }
}
